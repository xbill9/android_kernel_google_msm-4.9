<?xml version="1.0" encoding="UTF-8"?>
<!-- Unofficial LineageOS 24.0 for the Pixel 3a (sargo), started from the 23.2 port.
     Device trees: LineageOS stops at lineage-23.0; bonito, vendor and sdm845 display are xbill9 lineage-24.0 forks.
     gs-common: not used; thermal comes from hardware/google/pixel/thermal.
     Vendor and audio: the 23.2 forks. Kernel: the BPF backport tree. -->
<manifest>
  <project name="LineageOS/android_device_google_sargo" path="device/google/sargo" remote="github" revision="lineage-23.0" />
  <project name="xbill9/android_device_google_bonito" path="device/google/bonito" remote="github" revision="lineage-24.0" />
  <project name="LineageOS/android_packages_apps_ElmyraService" path="packages/apps/ElmyraService" remote="github" revision="lineage-24.0" />
  <project name="xbill9/android_kernel_google_msm-4.9" path="kernel/google/msm-4.9" remote="github" revision="main" />
  <project name="xbill9/proprietary_vendor_google_sargo" path="vendor/google/sargo" remote="github" revision="lineage-24.0" />
  <project name="xbill9/proprietary_vendor_google_bonito" path="vendor/google/bonito" remote="github" revision="lineage-24.0" />
  <!-- Dropped from LineageOS 24.0 (no sdm845-family devices); the 23.2 versions sargo built with. -->
  <project name="xbill9/android_hardware_qcom_sdm845_display" path="hardware/qcom/sdm845/display" remote="github" revision="lineage-24.0" groups="qcom,qcom_sdm845" />
  <project name="LineageOS/android_hardware_qcom_sdm845_gps" path="hardware/qcom/sdm845/gps" remote="github" revision="lineage-23.2" groups="qcom,qcom_sdm845" />
  <project name="xbill9/android_hardware_qcom_audio" path="hardware/qcom/audio" remote="github" revision="lineage-23.2" groups="qcom,qcom_audio,pdk-qcom" />
  <!-- LineageOS 24 dropped GCC; the 4.9 kernel still links with GNU binutils (gold for LTO), as in 23.2. -->
  <project name="LineageOS/android_prebuilts_gcc_linux-x86_aarch64_aarch64-linux-android-4.9" path="prebuilts/gcc/linux-x86/aarch64/aarch64-linux-android-4.9" remote="github" revision="lineage-19.1" clone-depth="1" />
  <project name="LineageOS/android_prebuilts_gcc_linux-x86_arm_arm-linux-androideabi-4.9" path="prebuilts/gcc/linux-x86/arm/arm-linux-androideabi-4.9" remote="github" revision="lineage-19.1" clone-depth="1" />
  <!-- clang and rust prebuilts are fetched by hand (partial clone, sparse checkout). -->
  <remove-project name="platform/prebuilts/rust" />
  <!-- Android 17 fixes for the 4.9 kernel: legacy fscrypt keyring (core, vold),
       BPF loaders, netd programs and ConnectivityService ring buffers. -->
  <remove-project name="LineageOS/android_system_core" />
  <project name="xbill9/android_system_core" path="system/core" remote="github" revision="lineage-24.0" groups="pdk" />
  <remove-project name="LineageOS/android_system_vold" />
  <project name="xbill9/android_system_vold" path="system/vold" remote="github" revision="lineage-24.0" groups="pdk" />
  <remove-project name="LineageOS/android_system_bpf" />
  <project name="xbill9/android_system_bpf" path="system/bpf" remote="github" revision="lineage-24.0" groups="pdk" />
  <!-- Native app zygote (zygote_next): skip capabilities newer than the 4.9 kernel. -->
  <remove-project name="platform/system/zygote" />
  <project name="xbill9/android_system_zygote" path="system/zygote" remote="github" revision="lineage-24.0" groups="pdk" />
  <remove-project name="LineageOS/android_packages_modules_Connectivity" />
  <project name="xbill9/android_packages_modules_Connectivity" path="packages/modules/Connectivity" remote="github" revision="lineage-24.0" groups="pdk-cw-fs,pdk-fs" />
</manifest>
